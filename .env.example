# ==============================================================================
# PayAgent: PayPal Developer Platform Configuration
# ==============================================================================
# Get your Sandbox API keys at: https://developer.paypal.com/dashboard/applications/sandbox

# 1. PayPal REST API Credentials (Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# 2. Server Configuration
PORT=3456
DEV_MODE=true

# Note: If PAYPAL_CLIENT_ID and PAYPAL_CLIENT_SECRET are left blank,
# PayAgent automatically runs in high-fidelity Sandbox Simulation mode
# so judges and contributors can test immediately without setup friction.
